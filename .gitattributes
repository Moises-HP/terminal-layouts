# Normaliza saltos de línea al clonar (clave para que funcione en cualquier PC):
#   scripts de bash/node → LF (bash falla con CRLF)
#   batch/powershell de Windows → CRLF
* text=auto eol=lf
*.sh   text eol=lf
*.mjs  text eol=lf
*.toml text eol=lf
*.md   text eol=lf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
